XHENC 1
# Byte field layout. Extended registers supply four-bit indices; low/high
# portions are selected here, never assembled by native target code.
rule MODRM 3 0
arg 0 2 0 1
arg 1 4 0 1
arg 2 4 0 1
bits 0 0 2 6
bits 1 0 3 3
bits 2 0 3 0
end
rule SIB 3 0
arg 0 2 0 1
arg 1 4 0 1
arg 2 4 0 1
bits 0 0 2 6
bits 1 0 3 3
bits 2 0 3 0
end
rule REX 4 0x40
arg 0 1 0 1
arg 1 4 0 1
arg 2 4 0 1
arg 3 4 0 1
bits 0 0 1 3
bits 1 3 1 2
bits 2 3 1 0
bits 3 3 1 1
end
rule REGOP 2 0
arg 0 8 0 1
arg 1 4 0 1
bits 0 3 5 3
bits 1 0 3 0
end
