XHRELOC 1
rule ABS32 4
set r0 S
set r1 A
add r0 r0 r1
range r0 32 unsigned
write r0 0 4
end
rule PC32 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
const r1 4
sub r0 r0 r1
range r0 32 signed
write r0 0 4
end
rule ABS64 8
set r0 S
set r1 A
add r0 r0 r1
write r0 0 8
end
rule PC64 8
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
const r1 4
sub r0 r0 r1
range r0 64 signed
write r0 0 8
end
rule ABS32_ADD 4
set r0 S
read r1 0 4
add r0 r0 r1
write r0 0 4
end
rule PC32_ADD 4
set r0 S
read r1 0 4
add r0 r0 r1
set r2 P
sub r0 r0 r2
const r2 4
sub r0 r0 r2
write r0 0 4
end
rule LOCAL_ABS32 4
set r0 S
set r1 A
add r0 r0 r1
set r1 B
add r0 r0 r1
range r0 32 unsigned
write r0 0 4
end
rule LOCAL_ABS64 8
set r0 S
set r1 A
add r0 r0 r1
set r1 B
add r0 r0 r1
write r0 0 8
end
