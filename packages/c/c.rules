rule runtime_ir_cmp_jmp_eq_26
text static inline long long ark_fld(char *f,int o,int sz,int u){long long v=0;\n    if(sz==1){signed char t;memcpy(&t,f+o,1);v=u?(long long)(unsigned char)t:(long long)t;}\n    else if(sz==2){short t;memcpy(&t,f+o,2);v=u?(long long)(unsigned short)t:(long long)t;}\n    else if(sz==4){int t;memcpy(&t,f+o,4);v=u?(long long)(unsigned int)t:(long long)t;}\n    else{long long t;memcpy(&t,f+o,8);v=t;}\n    return v;}\n
end
rule runtime_ir_cmp_jmp_eq_27
text static inline void ark_fst(char *f,int o,int sz,long long v){\n    if(sz==1){signed char t=(signed char)v;memcpy(f+o,&t,1);}\n    else if(sz==2){short t=(short)v;memcpy(f+o,&t,2);}\n    else if(sz==4){int t=(int)v;memcpy(f+o,&t,4);}\n    else{memcpy(f+o,&v,8);}\n}
end
