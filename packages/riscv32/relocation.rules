XHRELOC 1
# RV32 pair consumes actual image-relative S/P coordinates. Opcode and range
# checks run before atomically committing both instruction words.
rule RV_AUIPC_PAIR 8
read r0 0 4
read r1 4 4
checkmask r0 0x7f 0x17
checkanymask r1 0x7f 0x13 0x67
set r2 S
set r3 A
add r2 r2 r3
set r3 P
sub r2 r2 r3
const r3 0x800
add r4 r2 r3
asr r4 r4 12
range r4 20 signed
shl r5 r4 12
sub r6 r2 r5
range r6 12 signed
const r7 0xfffff
and r4 r4 r7
shl r4 r4 12
const r7 0xfff
and r0 r0 r7
or r0 r0 r4
and r6 r6 r7
shl r6 r6 20
const r7 0xfffff
and r1 r1 r7
or r1 r1 r6
write r0 0 4
write r1 4 4
end
rule RV_ABS32 4
set r0 S
set r1 B
add r0 r0 r1
set r1 A
add r0 r0 r1
write r0 0 4
end
rule ABS32 4
set r0 S
set r1 A
add r0 r0 r1
range r0 32 unsigned
write r0 0 4
end
rule PC32 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
const r1 4
sub r0 r0 r1
range r0 32 signed
write r0 0 4
end
rule ABS64 8
set r0 S
set r1 A
add r0 r0 r1
write r0 0 8
end
rule PC64 8
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
const r1 4
sub r0 r0 r1
range r0 64 signed
write r0 0 8
end
rule ABS32_ADD 4
set r0 S
read r1 0 4
add r0 r0 r1
write r0 0 4
end
rule PC32_ADD 4
set r0 S
read r1 0 4
add r0 r0 r1
set r2 P
sub r0 r0 r2
const r2 4
sub r0 r0 r2
write r0 0 4
end

rule ELF_ABS32 4
set r0 S
set r1 A
add r0 r0 r1
const r1 0xffffffff
and r0 r0 r1
write r0 0 4
end

rule ELF_BRANCH 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
range r0 13 signed
align r0 2
read r2 0 4
const r3 0x1fff07f
and r2 r2 r3
shr r4 r0 12
const r5 1
and r4 r4 r5
shl r4 r4 31
or r2 r2 r4
shr r4 r0 5
const r5 63
and r4 r4 r5
shl r4 r4 25
or r2 r2 r4
shr r4 r0 1
const r5 15
and r4 r4 r5
shl r4 r4 8
or r2 r2 r4
shr r4 r0 11
const r5 1
and r4 r4 r5
shl r4 r4 7
or r2 r2 r4
write r2 0 4
end

rule ELF_JAL 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
range r0 21 signed
align r0 2
read r2 0 4
const r3 0xfff
and r2 r2 r3
shr r4 r0 20
const r5 1
and r4 r4 r5
shl r4 r4 31
or r2 r2 r4
shr r4 r0 1
const r5 1023
and r4 r4 r5
shl r4 r4 21
or r2 r2 r4
shr r4 r0 11
const r5 1
and r4 r4 r5
shl r4 r4 20
or r2 r2 r4
shr r4 r0 12
const r5 255
and r4 r4 r5
shl r4 r4 12
or r2 r2 r4
write r2 0 4
end

rule ELF_HI20 4
set r0 S
set r1 A
add r0 r0 r1
const r1 0xffffffff
and r0 r0 r1
shl r0 r0 32
asr r0 r0 32
const r1 0x800
add r0 r0 r1
asr r0 r0 12
const r1 0xfffff
and r0 r0 r1
shl r0 r0 12
read r2 0 4
const r1 0xfff
and r2 r2 r1
or r2 r2 r0
write r2 0 4
end

rule ELF_PCREL_HI20 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
range r0 32 signed
const r1 0x800
add r0 r0 r1
asr r0 r0 12
const r1 0xfffff
and r0 r0 r1
shl r0 r0 12
read r2 0 4
const r1 0xfff
and r2 r2 r1
or r2 r2 r0
write r2 0 4
end

