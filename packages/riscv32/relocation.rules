rule ELF_CALL 8
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
range r0 32 signed
align r0 2
const r1 0x800
add r2 r0 r1
asr r2 r2 12
shl r3 r2 12
sub r3 r0 r3
const r1 0xfffff
and r2 r2 r1
shl r2 r2 12
read r4 0 4
const r1 0xfff
and r4 r4 r1
or r4 r4 r2
const r1 0xfff
and r3 r3 r1
shl r3 r3 20
read r5 4 4
const r1 0xfffff
and r5 r5 r1
or r5 r5 r3
write r4 0 4
write r5 4 4
end

rule ELF_ADD32 4
set r0 S
set r1 A
add r0 r0 r1
read r1 0 4
add r0 r1 r0
write r0 0 4
end

rule ELF_SUB32 4
set r0 S
set r1 A
add r0 r0 r1
read r1 0 4
