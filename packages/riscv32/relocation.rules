rule ELF_PCREL_LO12_S 4
set r0 S
set r1 A
add r0 r0 r1
set r1 P
sub r0 r0 r1
range r0 32 signed
read r2 0 4
const r1 0x1fff07f
and r2 r2 r1
const r1 31
and r3 r0 r1
shl r3 r3 7
or r2 r2 r3
shr r3 r0 5
const r1 127
and r3 r3 r1
shl r3 r3 25
