# RV32 scalar32 instruction sequences. Unmatched IR retains C fallback.
XHSELECT 3
# Native RV32 operand-binding contract; declared in package data.
register dst t0
register lhs t0
register rhs t1
allow add rrr
allow sub rrr
allow and rrr
allow or rrr
allow xor rrr
allow mul rrr
allow sll rrr
allow srl rrr
allow sra rrr
allow slt rrr
allow sltu rrr
allow div rrr
allow divu rrr
allow rem rrr
allow remu rrr
allow seqz rr
allow snez rr
allow xori rri
select ADD scalar32
emit add dst lhs rhs
end
select SUB scalar32
emit sub dst lhs rhs
end
select MUL scalar32
emit mul dst lhs rhs
end
select AND scalar32
emit and dst lhs rhs
end
select OR scalar32
emit or dst lhs rhs
end
select XOR scalar32
emit xor dst lhs rhs
end
select SHL scalar32
emit sll dst lhs rhs
end
select SHR_S scalar32
emit sra dst lhs rhs
end
select SHR_U scalar32
emit srl dst lhs rhs
end
select EQ scalar32
emit sub dst lhs rhs
emit seqz dst dst
end
select NE scalar32
emit sub dst lhs rhs
emit snez dst dst
end
select LT_S scalar32
emit slt dst lhs rhs
end
select LT_U scalar32
emit sltu dst lhs rhs
end
select GT_S scalar32
emit slt dst rhs lhs
end
select GT_U scalar32
emit sltu dst rhs lhs
end
select LE_S scalar32
emit slt dst rhs lhs
emit xori dst dst 1
end
select LE_U scalar32
emit sltu dst rhs lhs
emit xori dst dst 1
end
select GE_S scalar32
emit slt dst lhs rhs
emit xori dst dst 1
end
select GE_U scalar32
emit sltu dst lhs rhs
emit xori dst dst 1
end
select DIV_S scalar32
emit div dst lhs rhs
end
select DIV_U scalar32
emit divu dst lhs rhs
end
select MOD_S scalar32
emit rem dst lhs rhs
end
select MOD_U scalar32
emit remu dst lhs rhs
end
