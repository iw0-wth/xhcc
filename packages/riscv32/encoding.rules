# RV32 bit layouts, XH encoding VM v1. Arguments follow rv_enc_* helpers.
# R: funct7, rs2, rs1, funct3, rd, opcode
XHENC 1
rule R 6 0
arg 0 7 0 1
arg 1 5 0 1
arg 2 5 0 1
arg 3 3 0 1
arg 4 5 0 1
arg 5 7 0 1
bits 0 0 7 25
bits 1 0 5 20
bits 2 0 5 15
bits 3 0 3 12
bits 4 0 5 7
bits 5 0 7 0
end
# I: signed imm12, rs1, funct3, rd, opcode
rule I 5 0
arg 0 12 1 1
arg 1 5 0 1
arg 2 3 0 1
arg 3 5 0 1
arg 4 7 0 1
bits 0 0 12 20
bits 1 0 5 15
bits 2 0 3 12
bits 3 0 5 7
bits 4 0 7 0
end
# S: signed imm12, rs2, rs1, funct3, opcode
rule S 5 0
arg 0 12 1 1
arg 1 5 0 1
arg 2 5 0 1
arg 3 3 0 1
arg 4 7 0 1
bits 0 5 7 25
bits 1 0 5 20
bits 2 0 5 15
bits 3 0 3 12
bits 0 0 5 7
bits 4 0 7 0
end
# B: signed even byte offset13, rs2, rs1, funct3, opcode
rule B 5 0
arg 0 13 1 2
arg 1 5 0 1
arg 2 5 0 1
arg 3 3 0 1
arg 4 7 0 1
bits 0 12 1 31
bits 0 5 6 25
bits 1 0 5 20
bits 2 0 5 15
bits 3 0 3 12
bits 0 1 4 8
bits 0 11 1 7
bits 4 0 7 0
end
# U: unsigned high20, rd, opcode
rule U 3 0
arg 0 20 0 1
arg 1 5 0 1
arg 2 7 0 1
bits 0 0 20 12
bits 1 0 5 7
bits 2 0 7 0
end
# J: signed even byte offset21, rd, opcode
rule J 3 0
arg 0 21 1 2
arg 1 5 0 1
arg 2 7 0 1
bits 0 20 1 31
bits 0 1 10 21
bits 0 11 1 20
bits 0 12 8 12
bits 1 0 5 7
bits 2 0 7 0
end
