XHTEMPLATE 1
# ARM emission templates. Selection/ABI/optimization/Thumb encoding remain in C.
rule compare.eq
text     ITE EQ\n    MOVEQ r0, #1\n    MOVNE r0, #0\n
end
rule binary.eq
text     CMP r0, r1\n    ITE EQ\n    MOVEQ r0, #1\n    MOVNE r0, #0\n
end
rule compare.ne
text     ITE NE\n    MOVNE r0, #1\n    MOVEQ r0, #0\n
end
rule binary.ne
text     CMP r0, r1\n    ITE NE\n    MOVNE r0, #1\n    MOVEQ r0, #0\n
end
rule compare.lt
text     ITE LT\n    MOVLT r0, #1\n    MOVGE r0, #0\n
end
rule binary.lt
text     CMP r0, r1\n    ITE LT\n    MOVLT r0, #1\n    MOVGE r0, #0\n
end
rule compare.gt
text     ITE GT\n    MOVGT r0, #1\n    MOVLE r0, #0\n
end
rule binary.gt
text     CMP r0, r1\n    ITE GT\n    MOVGT r0, #1\n    MOVLE r0, #0\n
end
rule compare.le
text     ITE LE\n    MOVLE r0, #1\n    MOVGT r0, #0\n
end
rule binary.le
text     CMP r0, r1\n    ITE LE\n    MOVLE r0, #1\n    MOVGT r0, #0\n
end
rule compare.ge
text     ITE GE\n    MOVGE r0, #1\n    MOVLT r0, #0\n
end
rule binary.ge
text     CMP r0, r1\n    ITE GE\n    MOVGE r0, #1\n    MOVLT r0, #0\n
end
rule compare.ult
text     ITE LO\n    MOVLO r0, #1\n    MOVHS r0, #0\n
end
rule binary.ult
text     CMP r0, r1\n    ITE LO\n    MOVLO r0, #1\n    MOVHS r0, #0\n
end
rule compare.ugt
text     ITE HI\n    MOVHI r0, #1\n    MOVLS r0, #0\n
end
rule binary.ugt
text     CMP r0, r1\n    ITE HI\n    MOVHI r0, #1\n    MOVLS r0, #0\n
end
rule compare.ule
text     ITE LS\n    MOVLS r0, #1\n    MOVHI r0, #0\n
end
rule binary.ule
text     CMP r0, r1\n    ITE LS\n    MOVLS r0, #1\n    MOVHI r0, #0\n
end
rule compare.uge
text     ITE HS\n    MOVHS r0, #1\n    MOVLO r0, #0\n
end
rule binary.uge
text     CMP r0, r1\n    ITE HS\n    MOVHS r0, #1\n    MOVLO r0, #0\n
end
rule binary.add
text     ADD r0, r0, r1\n
end
rule binary.sub
text     SUB r0, r0, r1\n
end
rule binary.mul
text     MUL r0, r1\n
end
rule binary.div
