# Direct GNU Make + WASI SDK path. No Python invocation or generated source list.
# On Windows run with MSYS2 GNU Make; POSIX mkdir/cp/mv are required.
WASI_SDK_PATH ?= D:/wasi-sdk-34.0-x86_64-windows
WASM_OPT ?= D:/binaryen-version_133/bin/wasm-opt.exe
WASM_VALIDATE ?= D:/wabt-1.0.42/bin/wasm-validate.exe
ifeq ($(OS),Windows_NT)
WINDOWS_BASH ?= D:/msys64/usr/bin/bash.exe
HOST_TOOLS_DIR ?= D:/msys64/usr/bin
# Optional SDK DLL search directory; no Python executable is invoked.
DLL_DIR ?=
SHELL := $(WINDOWS_BASH)
export PATH := $(if $(DLL_DIR),$(DLL_DIR):)$(HOST_TOOLS_DIR):$(PATH)
EXE := .exe
endif
WASI_CC ?= $(WASI_SDK_PATH)/bin/clang$(EXE)
MEMORY_BYTES ?= 4194304
ROOT := $(CURDIR)
OUT := build/nopy
rwildcard = $(foreach p,$(wildcard $(1)*),$(if $(wildcard $(p)/.),$(call rwildcard,$(p)/,$(2)),$(filter $(subst *,%,$(2)),$(p))))
ALL_SRC := $(call rwildcard,src/,*.c) $(wildcard object/*.c)
COMMON_SRC := $(filter-out src/stages/% src/make/% src/link/main.c,$(ALL_SRC))
MAKE_SRC := $(filter src/make/%,$(ALL_SRC))
NO_LINK_SRC := $(filter-out src/link/%,$(COMMON_SRC))
LINK_SRC := src/link/main.c src/link/elf_link.c src/link/elf_read.c src/link/arm_elf_reloc.c src/link/ld_script.c src/backend/rules/relocation.c src/platform/wasi/flash_fs_host.c
HEADERS := $(call rwildcard,include/,*.h) $(call rwildcard,object/,*.inc) $(call rwildcard,src/,*.h) $(call rwildcard,src/,*.inc)
CFLAGS := -std=c99 -Oz -g0 -ffunction-sections -fdata-sections -include $(ROOT)/include/xh_small.h -I$(ROOT)/include -I$(ROOT)/object -DXH_TARGET=0 '-DXH_MODULE_TARGET="all"' -Wno-unused-value -Wno-incompatible-pointer-types --target=wasm32-wasip1 -mno-bulk-memory -mno-sign-ext -mno-nontrapping-fptoint -mno-simd128 -mno-atomics
LDFLAGS := --target=wasm32-wasip1 -Wl,--gc-sections -Wl,-z,stack-size=131072 -Wl,--initial-memory=$(MEMORY_BYTES) -Wl,--max-memory=$(MEMORY_BYTES)
LOWER := -Oz --signext-lowering --llvm-nontrapping-fptoint-lowering --llvm-memory-copy-fill-lowering --disable-reference-types --disable-multivalue --disable-extended-const --disable-bulk-memory --disable-bulk-memory-opt --disable-sign-ext --disable-nontrapping-float-to-int
VALIDATE := --disable-bulk-memory --disable-reference-types --disable-multi-value --disable-sign-extension --disable-saturating-float-to-int --disable-simd --disable-extended-const --disable-tail-call --disable-memory64 --disable-multi-memory
obj = $(addprefix $(OUT)/common/,$(addsuffix .o,$(basename $(1))))
COMMON_OBJ := $(call obj,$(COMMON_SRC))
MAKE_OBJ := $(call obj,$(MAKE_SRC))
LINK_OBJ := $(call obj,$(LINK_SRC))
N_MACRO_SRC := src/driver.c src/core/compiler.c src/ir/ipo.c
N_OBJ := $(filter-out $(call obj,$(N_MACRO_SRC)),$(call obj,$(NO_LINK_SRC))) $(addprefix $(OUT)/nolink/,$(addsuffix .o,$(basename $(N_MACRO_SRC))))
M_DRIVER := $(OUT)/make-driver/src/driver.o
.PHONY: all xhcc xhccm xhccn xhlinker
all: xhcc xhccm xhccn xhlinker
xhcc: build/wasm/xhcc.wasm
xhccm: build/wasm/xhccm.wasm
xhccn: build/wasm/xhccn.wasm
xhlinker: build/wasm/xhlinker.wasm
$(OUT)/common/%.o: %.c $(HEADERS) Makefile.nopy
	@mkdir -p "$(@D)"
	"$(WASI_CC)" $(CFLAGS) -c "$(ROOT)/$<" -o "$@"
$(OUT)/nolink/%.o: %.c $(HEADERS) Makefile.nopy
	@mkdir -p "$(@D)"
	"$(WASI_CC)" $(CFLAGS) -DXH_WITH_LINKER=0 -c "$(ROOT)/$<" -o "$@"
$(M_DRIVER): src/driver.c $(HEADERS) Makefile.nopy
	@mkdir -p "$(@D)"
	"$(WASI_CC)" $(CFLAGS) -DXH_DRIVER_NO_MAIN=1 -c "$(ROOT)/$<" -o "$@"
# App link rules share the same lowering and validation boundary as build.py.
define APP
$(OUT)/$(1)/$(1).wasm: $(2) Makefile.nopy
	@mkdir -p "$$(@D)"
	"$(WASI_CC)" $(2) -o "$$@" $(LDFLAGS) -Wl,-Map=$(OUT)/$(1)/$(1).map
	"$(WASM_OPT)" "$$@" $(LOWER) -o "$$@.lowered"
	"$(WASM_VALIDATE)" $(VALIDATE) "$$@.lowered"
	mv "$$@.lowered" "$$@"
build/wasm/$(1).wasm: $(OUT)/$(1)/$(1).wasm
	@mkdir -p "$$(@D)"
	cp "$$<" "$$@"
endef
$(eval $(call APP,xhcc,$(COMMON_OBJ)))
$(eval $(call APP,xhccm,$(filter-out $(call obj,src/driver.c),$(COMMON_OBJ)) $(M_DRIVER) $(MAKE_OBJ)))
$(eval $(call APP,xhccn,$(N_OBJ)))
$(eval $(call APP,xhlinker,$(LINK_OBJ)))
